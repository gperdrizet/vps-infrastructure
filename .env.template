# VPS Infrastructure - Environment Variables Template
# Copy this file to .env and fill in the actual values
# WARNING: Never commit .env to git! It's in .gitignore

# =============================================================================
# PostgreSQL Database Credentials
# =============================================================================

# LogKeep Database
POSTGRES_USER=logkeep_admin
POSTGRES_PASSWORD=<your-secure-password-here>
POSTGRES_DB=logkeep

# Bench Database (if separate instance)
BENCH_POSTGRES_PASSWORD=bench

# =============================================================================
# Grafana Configuration
# =============================================================================

GRAFANA_ADMIN_PASSWORD=<your-grafana-admin-password>

# SMTP Configuration for Grafana Alerts
SMTP_USER=<your-smtp-username>
SMTP_PASSWORD=<your-smtp-password>
SMTP_FROM=<alerts@yourdomain.com>

# =============================================================================
# Application Secrets
# =============================================================================

# Django Secret Key (LogKeep)
DJANGO_SECRET_KEY=<generate-with: python -c 'from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())'>

# =============================================================================
# External Services
# =============================================================================

# Pyrite PostgreSQL (Remote)
PYRITE_POSTGRES_HOST=100.64.0.2
PYRITE_POSTGRES_PORT=5432

# Database Connection Strings(for migration)
LOGKEEP_PROD_DB=postgresql://logkeep_user:<password>@100.64.0.2:5432/logkeep_prod
LOGKEEP_STAGING_DB=postgresql://logkeep_user:<password>@100.64.0.2:5432/logkeep_staging
BENCH_PROD_DB=postgresql://bench_user:<password>@100.64.0.2:5432/bench_prod
BENCH_STAGING_DB=postgresql://bench_user:<password>@100.64.0.2:5432/bench_staging

# =============================================================================
# Network Configuration
# =============================================================================

# Tailscale Network
TAILSCALE_NETWORK=100.64.0.0/10

# Domain Names
DOMAIN_BENCH=bench.perdrizet.org
DOMAIN_STAGING=staging.perdrizet.org
DOMAIN_HEADSCALE=headscale.perdrizet.org
DOMAIN_LLM=llm.perdrizet.org
DOMAIN_DB=db.perdrizet.org
